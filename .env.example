# Copy to .env and fill in.

# Any OpenAI-compatible API. Leave LLM_API_KEY empty to use extractive mode (no LLM).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Embeddings: sentence-transformers (default) or hashing (offline, no download)
EMBEDDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# MAX_DISTANCE=0.8

CHROMA_DIR=./chroma_db
